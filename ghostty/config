# font-family = "Cascadia Code"
font-family = "MesloLGS NF"
font-size = 12

quit-after-last-window-closed = true
# Force a real block cursor
cursor-style = block

# Make it visible on white
cursor-color = #000000
cursor-text = #ffffff

# Disable fancy blending
cursor-opacity = 1

# Theme
#
# Light Theme
# theme = breadog 

# Cozy Theme
# theme = Flexoki Light

# Catppuccin (matches nvim catppuccin-frappe)
theme = Catppuccin Frappe

# Opacity
background-opacity = 0.95
